{
  "name": "@gitnapp/biji-cli",
  "version": "0.1.0",
  "description": "CLI for Get笔记 (biji.com) — write / link / search / edit notes from your terminal",
  "main": "dist/cli.js",
  "bin": {
    "biji": "dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gitnapp/biji-cli.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/Gitnapp/biji-cli/tree/main/apps/cli#readme",
  "bugs": "https://github.com/Gitnapp/biji-cli/issues",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "biji",
    "get-biji",
    "notes",
    "cli",
    "note-taking",
    "markdown"
  ],
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@gitnapp/biji-client": "workspace:*",
    "@gitnapp/biji-queue": "workspace:*",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
