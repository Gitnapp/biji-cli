{
  "name": "@gitnapp/biji-cli",
  "version": "0.2.0",
  "description": "CLI + MCP server for Get笔记 (biji.com) — write / link / search / edit notes from your terminal, or `biji mcp` for AI clients",
  "main": "dist/biji.js",
  "bin": {
    "biji": "dist/biji.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gitnapp/biji-cli.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/Gitnapp/biji-cli/tree/main/apps/cli#readme",
  "bugs": "https://github.com/Gitnapp/biji-cli/issues",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/biji.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --noEmit && esbuild src/cli.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/biji.js --log-level=warning",
    "dev": "tsx src/cli.ts",
    "start": "node dist/biji.js",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "biji",
    "cli",
    "get-biji",
    "markdown",
    "mcp",
    "mcp-server",
    "note-taking",
    "notes"
  ],
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@gitnapp/biji-client": "workspace:*",
    "@gitnapp/biji-mcp": "workspace:*",
    "@gitnapp/biji-queue": "workspace:*",
    "@types/node": "^22.10.0",
    "commander": "^12.1.0",
    "esbuild": "^0.27.7",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
